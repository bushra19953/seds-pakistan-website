rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================
    // USER BILL OF RIGHTS - Three-Tiered Access Control Architecture
    // =============================================================
    // This security model implements a fundamental "User Bill of Rights" with
    // three distinct levels of access control:
    //
    // 1. PUBLIC ACCESS: Any user (authenticated or not) can read published content
    // 2. OWNER ACCESS: Authenticated users can always read their OWN documents
    // 3. ADMIN ACCESS: Users with appropriate permissions can read everything
    // =============================================================

    // -------------------------------------------------------------
    // Core Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.token != null;
    }

    // High-reactivity role discovery. TOTAL function: it must never error,
    // because an error in the FIRST disjunct of an allow expression aborts
    // the whole expression before later disjuncts are evaluated (Firestore
    // rules propagate errors immediately; they do not fall through to a
    // later true branch). Two unguarded accesses used to error here:
    // (1) request.auth.token.role when the ID token carries no role custom
    // claim (every fresh user: claims are only stamped when a roles/{uid}
    // doc is written), and (2) get(roles/{uid}).data.role when the roles
    // doc exists without a role field. Either error denied EVERY users
    // update for a claim-less user, including the induction submit flag
    // write, even though isOwnApplicationSubmit would have allowed it.
    // Both accesses are now guarded: a missing claim or a missing role
    // field yields null (no role), never an error.
    function currentRole() {
      return isSignedIn()
        ? (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', null)
            : ((('role' in request.auth.token) && request.auth.token.role is string) ? request.auth.token.role : null))
        : null;
    }

    function isSuperAdmin() {
      // Role-based authority: users with the 'superadmin' role
      return isSignedIn() && currentRole() == 'superadmin';
    }

    // Role-based protection: true if the target user's role document
    // currently grants 'superadmin'. Used to prevent demotion or
    // deletion of superadmin role assignments.
    function isTargetSuperAdmin(targetUid) {
      return exists(/databases/$(database)/documents/roles/$(targetUid)) &&
             get(/databases/$(database)/documents/roles/$(targetUid)).data.role == 'superadmin';
    }

    function isPresident() {
      return isSignedIn() && currentRole() == 'president_national';
    }

    // Founder bypass (Bug 1 fix): the founder UID is treated as a peer of
    // superadmin for role-management gates, independent of any role doc.
    function isFounder() {
      return isSignedIn() && request.auth.uid == 'pLW0PuQCTAQHCNK1SfllVhPZdMz1';
    }

    // High-Level Leadership that bypasses bootstrap RBAC lookups for critical config
    function isExecutive() {
      return isSuperAdmin() || isPresident();
    }

    // Broad admin access used for read-only dashboards like analytics
    function hasSiteAdminAccess() {
      return isExecutive() || hasPermission('canAccessAdmin');
    }

    // OWNER ACCESS HELPER: Checks if the current user owns the document
    function isOwner(docId) {
      return isSignedIn() && request.auth.uid == docId;
    }

    // Vote increments: a signed-in user may increment ONLY the upvotes or
    // downvotes counter of another user's document, by exactly 1, changing
    // nothing else. The voter must have a vote document (created in the same
    // client transaction), which ties the counter to a real one-per-person vote.
    function isVoteIncrement() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let upBefore = resource.data.upvotes == null ? 0 : resource.data.upvotes;
      let downBefore = resource.data.downvotes == null ? 0 : resource.data.downvotes;
      let upAfter = request.resource.data.upvotes;
      let downAfter = request.resource.data.downvotes;
      return keys.hasOnly(['upvotes', 'downvotes', 'updatedAt'])
        && upAfter is number && downAfter is number
        && (
          (upAfter == upBefore + 1 && downAfter == downBefore) ||
          (downAfter == downBefore + 1 && upAfter == upBefore)
        )
        && exists(/databases/$(database)/documents/users/$(userId)/votes/$(request.auth.uid));
    }

    // Single permission gate using the definitive matrix.
    // DYNAMIC & ROBUST: Checks multiple role variations for compatibility.
    // TOTAL function: data[permission] on a permissions doc that exists
    // but lacks the key errors ("Property X is undefined") and that error
    // aborts the whole allow expression before later disjuncts are
    // evaluated. .get(permission, false) returns false for a missing key:
    // a missing key means "not granted", never an error, never granted.
    function hasPermission(permission) {
      return isSignedIn() && currentRole() != null && (
        (exists(/databases/$(database)/documents/permissions/$(currentRole())) &&
         get(/databases/$(database)/documents/permissions/$(currentRole())).data.get(permission, false) == true) ||
        (exists(/databases/$(database)/documents/permissions/$(currentRole().lower())) &&
         get(/databases/$(database)/documents/permissions/$(currentRole().lower())).data.get(permission, false) == true)
      );
    }

    function isWorkflowMember(wfId, uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/workflow_members/$(wfId + "_" + uid));
    }

    // PERMISSIONS COLLECTION - ROLE-LEVEL POLICY DOCUMENTS
    match /permissions/{roleId} {
      allow get: if isExecutive() || (isSignedIn() && roleId.lower() == currentRole().lower());
      allow list: if isExecutive();
      allow create, update, delete: if isExecutive() || hasPermission('canManagePermissions');
    }

    // ROLE DEFINITIONS COLLECTION - ADMIN ACCESS ONLY
    match /roleDefinitions/{id} {
      allow get: if isSignedIn();
      allow list: if isExecutive() || hasPermission('canManagePermissions');
      allow write: if isExecutive() || hasPermission('canManagePermissions');
    }

    // LEGACY ROLE PERMISSIONS FALLBACK
    match /role_permissions/{id} {
      allow get: if isSignedIn();
      allow list: if isExecutive() || hasPermission('canManagePermissions');
      allow write: if isExecutive() || hasPermission('canManagePermissions');
    }

    match /leave_audit/{id} {
      allow read, list: if isSignedIn();
      allow write: if isExecutive();
    }

    // LEAVE REQUESTS - member-filed leave applications.
    // This ships with the rest of the leave build. It must be pasted into
    // the Firebase Console by Zubair. It must NOT be published by agents.
    // Create is owner-only with a strict field allow-list and status locked
    // to 'pending', so a member can never self-approve or forge a review
    // outcome on create. Update and delete are denied to all client
    // callers: every status change goes through the Admin SDK in
    // universal-review, never through a client write.
    match /leave_requests/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['userId', 'reason', 'startDate', 'endDate', 'leaveType', 'coveringOfficerId', 'coveringOfficerName', 'notes', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.status == 'pending'
                    && !('reviewedAt' in request.resource.data)
                    && !('reviewedBy' in request.resource.data)
                    && !('approvedBy' in request.resource.data);
      allow get: if isSignedIn()
                 && (resource.data.userId == request.auth.uid || isExecutive() || hasPermission('canManageApplications'));
      allow list: if isSignedIn();
      allow update, delete: if false;
    }

    // USERS COLLECTION - reads require sign-in (phone numbers must not be
    // anonymously harvestable); writes strictly validated with a
    // privileged-fields guard so owners cannot self-unban or escalate.
    match /users/{userId} {
      allow get, list: if isSignedIn();

      function isValidUserData() {
        // Leaderboard counters must stay numeric when present. Fields are
        // optional so admin updates (e.g. warningCount increments) are never
        // blocked on user docs that predate these fields.
        return (!('points' in request.resource.data) || request.resource.data.points is number) &&
               (!('upvotes' in request.resource.data) || request.resource.data.upvotes is number) &&
               (!('downvotes' in request.resource.data) || request.resource.data.downvotes is number) &&
               (!('customTitle' in request.resource.data) || request.resource.data.customTitle is string) &&
               (!('username' in request.resource.data) || request.resource.data.username is string) &&
               (!('publicDirectoryOptIn' in request.resource.data) || request.resource.data.publicDirectoryOptIn is bool);
      }

      // Fields that only admins may change. Owners attempting to write
      // these (e.g. isBanned:false to self-unban) are rejected.
      // customTitle is display-only and admin-granted: owners must not be
      // able to give themselves an official-looking title. The role-mirror
      // branch below still lets role managers set it.
      function privilegedFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isBanned', 'banReason', 'bannedAt', 'bannedBy',
                   'role', 'displayRole', 'customTitle',
                   'isOnVacation', 'vacationMode', 'coveringOfficerId',
                   'vacationStartDate', 'vacationEndDate', 'leaveRequestId',
                   'warningCount', 'isBlacklisted', 'blacklistReason',
                   'hasApplied', 'applicationStatus',
                   'managerId']);
      }

      function isRoleManagementUpdate() {
        // Role managers may mirror the canonical roles/{uid}.role onto the
        // user doc. 'role' is included so the two stores cannot drift.
        // Superadmin, the national president, and the founder may use this
        // path as peers (Bug 1 403 fix). customTitle rides the same path:
        // it is display-only, never feeds permission checks, and is never
        // written into roles/{uid}.role.
        return (isSuperAdmin() || isPresident() || isFounder() || hasPermission('canManageRoles')) &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'displayRole', 'customTitle', 'updatedAt']);
      }

      function isApplicationStatusUpdate() {
        // Admins who review induction applications may mirror the review
        // outcome onto the applicant's user doc. Restricted to the three
        // fields the induction flow reads; nothing else can be touched.
        return hasPermission('canManageApplications') &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['applicationStatus', 'hasApplied', 'updatedAt']);
      }

      function isOwnApplicationSubmit() {
        // Fresh applicants must be able to set their own hasApplied flag
        // when they submit the induction form (the submit batch writes the
        // application doc and this flag atomically). Values are locked:
        // hasApplied must be true and applicationStatus must be 'pending',
        // so an applicant can never approve themselves or clear the flag.
        // Field set is locked to hasOnly: role, points, ban fields etc.
        // cannot be touched through this branch.
        // Pre-image guard: a doc already 'approved' cannot use this path;
        // admin must handle an approved resubmission.
        return isOwner(userId) &&
               (!('applicationStatus' in resource.data) || resource.data.applicationStatus != 'approved') &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['hasApplied', 'applicationStatus', 'updatedAt']) &&
               request.resource.data.hasApplied == true &&
               request.resource.data.applicationStatus == 'pending';
      }

      function isOwnReapply() {
        // A rejected applicant may clear their own hasApplied flag to
        // re-apply. Locked: the stored status must be 'rejected', only the
        // three induction fields may change, and the flag must go false
        // with the status cleared. Pending/approved applicants cannot use
        // this path, and nobody can touch anyone else's flag.
        return isOwner(userId) &&
               resource.data.applicationStatus == 'rejected' &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['hasApplied', 'applicationStatus', 'updatedAt']) &&
               request.resource.data.hasApplied == false &&
               request.resource.data.applicationStatus == null;
      }

      // Owner-only creation with a strict field allow-list. This closes
      // the privilege-planting hole: the old grant let a fresh account
      // create its own doc carrying role, points, ban fields, or a
      // self-approved induction status. Role is 'member' only (the only
      // value legitimate signup writes). Invite-based non-member roles
      // must be assigned server-side; a client setDoc carrying one is
      // denied here. Counters must be absent or zero. Induction flags
      // are locked to safe values. Admin/ban/vacation/blacklist/
      // manager fields are denied by omission from the allow-list.
      function isSafeUserCreate() {
        return isSignedIn() && request.auth.uid == userId
               && isValidUserData()
               && request.resource.data.keys().hasOnly(['uid', 'email', 'photoURL',
                  'displayName', 'university', 'fieldOfStudy', 'department',
                  'role', 'chapterId',
                  'points', 'upvotes', 'downvotes',
                  'tasksAssignedCount', 'tasksCompletedOnTimeCount',
                  'createdAt', 'updatedAt', 'lastSeenAt',
                  'agreedToTermsAt', 'agreedToTermsVersion', 'termsAgreementTimestamp',
                  'termsAccepted', 'termsAcceptedAt', 'termsVersion',
                  'profileCompletedAt',
                  'whatsapp', 'whatsappNumber',
                  'hasApplied', 'applicationStatus'])
               && (!('role' in request.resource.data) || request.resource.data.role == 'member')
               && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
               && (!('email' in request.resource.data) || request.resource.data.email is string)
               && (!('chapterId' in request.resource.data) || request.resource.data.chapterId is string)
               && (!('points' in request.resource.data) || request.resource.data.points == 0)
               && (!('upvotes' in request.resource.data) || request.resource.data.upvotes == 0)
               && (!('downvotes' in request.resource.data) || request.resource.data.downvotes == 0)
               && (!('tasksAssignedCount' in request.resource.data) || request.resource.data.tasksAssignedCount == 0)
               && (!('tasksCompletedOnTimeCount' in request.resource.data) || request.resource.data.tasksCompletedOnTimeCount == 0)
               && (!('hasApplied' in request.resource.data) || request.resource.data.hasApplied is bool)
               && (!('applicationStatus' in request.resource.data) || request.resource.data.applicationStatus == 'pending' || request.resource.data.applicationStatus == null);
      }

      allow create: if isSafeUserCreate();
      allow update: if ((isSuperAdmin() || hasPermission('canManageUsers')) && isValidUserData())
                    || (isOwner(userId) && isValidUserData() && privilegedFieldsUnchanged())
                    || (isRoleManagementUpdate() && isValidUserData())
                    || (isApplicationStatusUpdate() && isValidUserData())
                    || (isOwnApplicationSubmit() && isValidUserData())
                    || (isOwnReapply() && isValidUserData())
                    || (isSignedIn() && isVoteIncrement() && isValidUserData());
      allow delete: if isSuperAdmin() || hasPermission('canManageUsers');
    }

    // LEADERBOARD VOTES - any signed-in user may cast one vote per person.
    // The vote document id must equal the voter's uid so the client can
    // enforce one-vote-per-person; votes are immutable (delete + recreate
    // to change, which the client does not yet offer).
    match /users/{userId}/votes/{voterId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == voterId
                    && request.resource.data.voterUid == voterId
                    && request.resource.data.type in ['up', 'down'];
      allow update: if false;
      allow delete: if isSignedIn() && (request.auth.uid == voterId || isSuperAdmin() || hasPermission('canManageUsers'));
    }

    // PRIVATE CONTACT - phone numbers and emails live here, never in the
    // public user document. Owner, managers, and user-admins only.
    match /users/{userId}/private/contact {
      allow get: if isOwner(userId) || isSuperAdmin() || hasPermission('canManageUsers');
      allow list: if isOwner(userId) || isSuperAdmin() || hasPermission('canManageUsers');
      allow write: if isOwner(userId) || isSuperAdmin() || hasPermission('canManageUsers');
    }

    // ROLES COLLECTION - authenticated reads; writes restricted via role checks.
    // Bug 1 fix: the national president and the founder UID are peers of
    // superadmin for this gate. The target-superadmin guard and the
    // reserved-string guards ('superadmin', 'president_national' can never
    // be written through this path) are unchanged.
    match /roles/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if (isSuperAdmin() || isPresident() || isFounder() || hasPermission('canManageRoles')) &&
                                     !isTargetSuperAdmin(userId) &&
                                     request.resource.data.role != 'superadmin' &&
                                     request.resource.data.role != 'president_national';
    }

    // =============================================================
    // CONTENT COLLECTIONS - Public Read Access
    // =============================================================

    match /blogs/{blogId} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageBlogs');
    }

    match /events/{eventId} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageEvents');
    }

    match /workshops/{workshopId} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageWorkshops');
    }

    match /announcements/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageAnnouncements');
    }

    match /projects/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageProjects');
    }

    match /resources/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageResources');
    }

    match /competitions/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageResources');
    }

    match /partners/{id} {
      allow read, list: if isSuperAdmin() || isExecutive() || hasPermission('canManageResources') || hasPermission('canManageEvents');
      allow write: if isSuperAdmin() || hasPermission('canManageResources') || hasPermission('canManageEvents');
    }

    match /sponsors_partners/{id} {
      allow read, list: if isSuperAdmin() || isExecutive() || hasPermission('canManageResources') || hasPermission('canManageEvents');
      allow write: if isSuperAdmin() || hasPermission('canManageResources') || hasPermission('canManageEvents');
    }

    match /legalDocuments/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManagePages');
    }

    match /pages/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManagePages');
    }

    match /timeline/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageTimeline');
    }

    match /skills/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageSkills');
    }

    match /forms/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageForms');
    }

    match /products/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageStore');
    }

    // =============================================================
    // ORGANIZATIONAL COLLECTIONS
    // =============================================================

    match /organizations/{organizationId} {
      allow get, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageOrganizations');
    }

    match /teamMembers/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageUsers');
    }

    match /roleHistory/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageRoles');
    }

    match /chapters/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageChapters');
    }

    match /positions/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManagePositions');
    }

    match /badges/{id} {
      allow read, list: if true;
      allow write: if isSuperAdmin() || hasPermission('canManageBadges');
    }

    // =============================================================
    // OPERATIONAL COLLECTIONS - Mixed Access
    // =============================================================

    match /tasks/{taskId} {
      allow read, list: if isSuperAdmin() || 
                       hasPermission('canManageTasks') || 
                       resource.data.assigneeId == request.auth.uid ||
                       resource.data.workflowId != null; // Public visibility for national missions
      allow write: if isSuperAdmin() || hasPermission('canManageTasks');
    }

    match /role_requests/{id} {
      allow get: if isSuperAdmin() || hasPermission('canManageRoles') || resource.data.userId == request.auth.uid;
      allow list: if isSuperAdmin() || hasPermission('canManageRoles');
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || hasPermission('canManageRoles');
    }

    match /chapter_applications/{id} {
      allow get: if isSuperAdmin() || hasPermission('canManageChapterApplications') || resource.data.userId == request.auth.uid;
      allow list: if isSuperAdmin() || hasPermission('canManageChapterApplications');
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || hasPermission('canManageChapterApplications');
    }

    match /applications/{id} {
      allow read, list: if isSuperAdmin() || isExecutive() || hasPermission('canManageApplications');
      // Doc id must equal the applicant's uid so a signed-in user cannot
      // pre-create another user's application document and block their
      // submit. Minimal payload check: embedded uid matches the caller and
      // an email string is present. Status is locked to 'pending' and
      // admin-only fields (reviewed_by, rejection_reason, reviewed_at)
      // must be absent, so a fresh applicant can never self-approve or
      // forge a review outcome on create.
      allow create: if isSignedIn() && request.auth.uid == id
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.status == 'pending'
                    && !('reviewed_by' in request.resource.data)
                    && !('rejection_reason' in request.resource.data)
                    && !('reviewed_at' in request.resource.data)
                    && !('pre_score' in request.resource.data)
                    && !('role' in request.resource.data)
                    && !('isAdmin' in request.resource.data);
      // Owner re-apply: a signed-in applicant may update ONLY their own
      // application doc (doc id equals uid) and only back to pending.
      // This covers re-apply after rejection and re-submit while pending.
      // Status is locked to 'pending' so an applicant can never approve,
      // shortlist, or otherwise escalate their own application.
      // Tightened guards: the EXISTING doc must already belong to the
      // caller (pre-image uid binding) and must currently be 'pending'
      // or 'rejected' or in review ('under_review', 'shortlisted',
      // 'on_hold') (an 'approved' doc cannot be owner-updated; admin
      // must handle an approved resubmission). A resubmission always
      // resets status to 'pending', so widening to in-review statuses
      // cannot escalate anyone; it only lets an in-review applicant
      // overwrite their own in-review application and re-enter the
      // queue. Email is immutable (new
      // email must equal the existing email), and the new
      // doc must not contain admin-only fields (reviewed_by,
      // rejection_reason, reviewed_at, pre_score, role, isAdmin). The admin-fields check is on
      // the new doc as a whole, not a diff: the client uses plain
      // batch.set (replace), so a legitimate re-apply REMOVES
      // rejection_reason from a rejected doc, and a diff-based check
      // would wrongly deny that removal.
      allow update: if (isSuperAdmin() || hasPermission('canManageApplications'))
                    || (isSignedIn() && request.auth.uid == id
                        && request.resource.data.uid == request.auth.uid
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.email == resource.data.email
                        && resource.data.status in ['pending', 'rejected', 'under_review', 'shortlisted', 'on_hold']
                        && request.resource.data.status == 'pending'
                        && !('reviewed_by' in request.resource.data)
                        && !('rejection_reason' in request.resource.data)
                        && !('reviewed_at' in request.resource.data)
                        && !('pre_score' in request.resource.data)
                        && !('role' in request.resource.data)
                        && !('isAdmin' in request.resource.data));
      allow delete: if isSuperAdmin() || hasPermission('canManageApplications');
    }

    match /submissions/{id} {
      allow read, write: if isSuperAdmin() || hasPermission('canManageInbox');
      allow create: if true; // Allow public form submissions
    }

    match /eventTickets/{id} {
      allow read: if isSuperAdmin() || hasPermission('canManageEvents') || resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    match /orders/{id} {
      allow read: if isSuperAdmin() || hasPermission('canManageStore') || resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || hasPermission('canManageStore');
    }

    match /messages/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || hasPermission('canManageTasks') || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }

    // =============================================================
    // SYSTEM COLLECTIONS - Admin Only
    // =============================================================

    match /settings/{id} {
      allow read: if true; // Allow public read for Trust Bar stats
      allow write: if isSuperAdmin() || hasPermission('canManageSiteSettings');
    }

    match /audit_logs/{id} {
      allow read: if isSuperAdmin() || hasPermission('canViewAuditLogs');
      // logAuditEntry writes the actor field as actorUid; the rule must match it
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
    }

    // UPLOAD LOGS - server-side upload tracking records. Written only via the
    // Admin SDK (which bypasses rules), so all client writes are denied.
    // Users may read their own logs (userId field); admins can read all.
    match /upload_logs/{logId} {
      allow create: if false;
      allow update, delete: if false;
      allow read: if hasSiteAdminAccess() || resource.data.userId == request.auth.uid;
      allow list: if hasSiteAdminAccess() || request.auth.uid != null;
    }

    match /bug_reports/{reportId} {
      allow read, write: if isSuperAdmin() || hasPermission('canManageBugReports');
      allow create: if isSignedIn();
    }

    match /pageVisits/{id} {
      allow read: if isSuperAdmin() || hasPermission('canViewAnalytics');
      allow create: if true;
    }

    match /analyticsEvents/{id} {
      allow read: if isSuperAdmin() || hasPermission('canViewAnalytics');
      allow create: if true;
    }

    // Transient collaboration data
    match /workflow_presence/{id} {
      allow read, write: if isSignedIn();
    }
    match /workflow_typing/{id} {
      allow read, write: if isSignedIn();
    }

    // Induction form drafts - each user may only read and write their own
    // draft document (doc id equals uid). Binds the doc id to the caller so
    // one user cannot read or overwrite another user's draft.
    match /drafts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Authority refresh signals - lets the app nudge a user's client to
    // force-refresh their ID token (picking up new custom claims) right
    // after a role change. The doc carries no privileged data; the target
    // user's listener clears it after processing.
    match /authority_refresh/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && (request.auth.uid == userId
                   || isSuperAdmin() || hasPermission('canManageRoles') || hasPermission('canManageUsers'));
    }

    match /warningConfig/{id} {
      allow read, list: if isSignedIn();
      allow write: if isSuperAdmin() || hasPermission('canManageDefaulters');
    }

    // User sub-collections
    match /users/{userId}/notifications/{id} {
      allow read: if isOwner(userId);
      allow write: if isSuperAdmin();
    }

    match /users/{userId}/warnings/{id} {
      allow read: if isOwner(userId) || isSuperAdmin() || hasPermission('canManageDefaulters');
      allow write: if isSuperAdmin() || hasPermission('canManageDefaulters');
    }
  }
}
