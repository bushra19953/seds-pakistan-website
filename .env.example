# ============================================================
# SEDS Pakistan Website — Environment Variables Template
# Copy this file to .env.local and fill in your real values
# ============================================================

# Firebase Client-Side Config (get from Firebase Console → Project Settings → Your App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (get from Firebase Console → Project Settings → Service Accounts)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}  # paste full JSON as one line

# Google OAuth (if using Google Sign-In via server)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com

# Push Notifications (Firebase Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# SMTP Email (optional — project uses Gmail SMTP by default)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=SEDS Pakistan

# Node Environment
NODE_ENV=development
