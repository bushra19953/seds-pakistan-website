# =====================================================================
# SEDS Pakistan Website - .env.local TEMPLATE
# =====================================================================
# Copy this file to .env.local and replace every placeholder value with
# the real one. This template is safe to commit; .env.local must NEVER
# be committed (it is covered by .gitignore via the .env* rules).
#
# Run `python3 scripts/validate_env.py` at any time to audit which
# values are still missing, empty, or placeholders.
# =====================================================================

# ---------------------------------------------------------------------
# Firebase client config (public identifiers, inlined at build time).
# Purpose: initializes the Firebase web app on the client.
# Format: plain strings from your Firebase web app config.
# Obtain: Firebase Console -> Project Settings -> Your apps -> Web app.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ---------------------------------------------------------------------
# Google Drive picker key (client).
# Purpose: file picker for Drive-backed uploads in the browser.
# Format: Google Cloud API key string.
# Obtain: Google Cloud Console -> APIs and Services -> Credentials.
# ---------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# ---------------------------------------------------------------------
# Firebase Cloud Messaging VAPID key (client, optional).
# Purpose: web push notification subscriptions.
# Format: VAPID public key string.
# Obtain: Firebase Console -> Project Settings -> Cloud Messaging.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_public_key_here

# ---------------------------------------------------------------------
# Gmail SMTP (server only, REQUIRED for outgoing email).
# Purpose: credentials used by src/lib/mailer.ts via Nodemailer.
# Format: full Gmail address; 16-character app password (no spaces).
# Obtain: Google Account -> Security -> 2-Step Verification ->
#         App passwords -> create one for "Mail".
# ---------------------------------------------------------------------
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ---------------------------------------------------------------------
# Resend (server only, fallback email provider).
# Purpose: backup sender when Gmail SMTP is unavailable.
# Format: re_ followed by the key string.
# Obtain: https://resend.com -> API Keys -> Create API Key.
# ---------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here

# ---------------------------------------------------------------------
# Stripe (server only, REQUIRED for payments).
# Purpose: STRIPE_SECRET_KEY charges customers; STRIPE_WEBHOOK_SECRET
#          verifies inbound payment webhooks in
#          src/app/api/payments/webhook/route.ts.
# Format: sk_live_... / sk_test_... ; whsec_... for the webhook secret.
# Obtain: https://dashboard.stripe.com -> Developers -> API keys, and
#         Developers -> Webhooks -> select endpoint -> Signing secret.
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# ---------------------------------------------------------------------
# Firestore inbound webhook shared secret (server only).
# Purpose: x-webhook-secret checked with timing-safe comparison in
#          src/app/api/webhooks/firestore/route.ts before any role
#          mutation. Must match the sender's configured secret.
# Format: long random string (generate with: openssl rand -hex 32).
# Obtain: agree on a value with the webhook sender; store it here and
#         in the sender configuration.
# ---------------------------------------------------------------------
FIRESTORE_WEBHOOK_SECRET=your_firestore_webhook_secret_here

# ---------------------------------------------------------------------
# Google Gemini (server only, NEVER expose to the browser).
# Purpose: powers /api/ai/* server routes (match-partners, task
#          breakdown, pitch generation). Client pages must never read
#          this; they call the server routes instead.
# Format: AIza... API key string.
# Obtain: https://aistudio.google.com -> API keys -> Create API key.
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# Crucible certificate salt (server only, NEVER expose or hardcode).
# Purpose: feeds the SHA-256 certificate hash in
#          src/lib/certificates/hash.ts. Changing it invalidates
#          previously issued certificate hashes.
# Format: 64 lowercase hex characters.
# Obtain: run `openssl rand -hex 32` once and keep the output secret.
# ---------------------------------------------------------------------
CERTIFICATE_SALT=your_random_64_hex_char_salt_here

# ---------------------------------------------------------------------
# AGP institutional invoicing details (server only).
# Purpose: official SEDS Aerospace Private Limited billing details
#          printed on chapter invoices by
#          src/app/api/v1/chapters/invoice/route.ts.
# Format: SEDS_NTN like 0000000-0; SEDS_BANK_NAME plain text;
#         SEDS_IBAN like PK00 followed by 20 digits.
# Obtain: the organization's NTN certificate and bank account papers.
# ---------------------------------------------------------------------
SEDS_NTN=0000000-0
SEDS_BANK_NAME=your_official_bank_name_here
SEDS_IBAN=PK00_0000_0000_0000_0000_0000
