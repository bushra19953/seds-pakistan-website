  images: {
    unoptimized: false,
    remotePatterns: [
      // Allow ALL external images from any domain
      { protocol: 'https', hostname: '**' },
      { protocol: 'http', hostname: '**' },
    ],
  },

  // Production optimizations
  compiler: {
    removeConsole: process.env.NODE_ENV === 'production',
