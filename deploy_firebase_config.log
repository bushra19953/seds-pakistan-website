[2026-04-22T05:22:48.423Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/seds-pakistan/rulesets 200
[2026-04-22T05:22:48.423Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/seds-pakistan/rulesets {"name":"projects/seds-pakistan/rulesets/313d0749-41e8-4d25-8b8a-168efe4a9875","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // =============================================================\n    // USER BILL OF RIGHTS - Three-Tiered Access Control Architecture\n    // =============================================================\n    // This security model implements a fundamental \"User Bill of Rights\" with\n    // three distinct levels of access control:\n    //\n    // 1. PUBLIC ACCESS: Any user (authenticated or not) can read published content\n    // 2. OWNER ACCESS: Authenticated users can always read their OWN documents\n    // 3. ADMIN ACCESS: Users with appropriate permissions can read everything\n    // =============================================================\n\n    // -------------------------------------------------------------\n    // Core Helper Functions\n    // -------------------------------------------------------------\n    function isSignedIn() {\n      return request.auth != null && request.auth.uid is string && request.auth.token != null;\n    }\n\n    // High-reactivity role discovery\n    function currentRole() {\n      return isSignedIn() \n        ? (exists(/databases/$(database)/documents/roles/$(request.auth.uid))\n            ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role\n            : (request.auth.token.role is string ? request.auth.token.role : null))\n        : null;\n    }\n\n    function isSuperAdmin() {\n      // ABSOLUTE AUTHORITY: Founder UID or role explicitly tagged 'superadmin'\n      return isSignedIn() && (request.auth.uid == 'pLW0PuQCTAQHCNK1SfllVhPZdMz1' || currentRole() == 'superadmin');\n    }\n\n    function isPresident() {\n      return isSignedIn() && currentRole() == 'president_national';\n    }\n\n    // High-Level Leadership that bypasses bootstrap RBAC lookups for critical config\n    function isExecutive() {\n      return isSuperAdmin() || isPresident();\n    }\n\n    // Broad admin access used for read-only dashboards like analytics\n    function hasSiteAdminAccess() {\n      return isExecutive() || hasPermission('canAccessAdmin');\n    }\n\n    // OWNER ACCESS HELPER: Checks if the current user owns the document\n    function isOwner(docId) {\n      return isSignedIn() && request.auth.uid == docId;\n    }\n\n    // Single permission gate using the definitive matrix.\n    // DYNAMIC & ROBUST: Checks multiple role variations for compatibility.\n    function hasPermission(permission) {\n      return isSignedIn() && currentRole() != null && (\n        (exists(/databases/$(database)/documents/permissions/$(currentRole())) &&\n         get(/databases/$(database)/documents/permissions/$(currentRole())).data[permission] == true) ||\n        (exists(/databases/$(database)/documents/permissions/$(currentRole().lower())) &&\n         get(/databases/$(database)/documents/permissions/$(currentRole().lower())).data[permission] == true)\n      );\n    }\n\n    function isWorkflowMember(wfId, uid) {\n      return isSignedIn() && exists(/databases/$(database)/documents/workflow_members/$(wfId + \"_\" + uid));\n    }\n\n    // PERMISSIONS COLLECTION - ROLE-LEVEL POLICY DOCUMENTS\n    match /permissions/{roleId} {\n      allow get: if isExecutive() || (isSignedIn() && roleId.lower() == currentRole().lower());\n      allow list: if isExecutive();\n      allow create, update, delete: if isExecutive() || hasPermission('canManagePermissions');\n    }\n\n    // ROLE DEFINITIONS COLLECTION - ADMIN ACCESS ONLY\n    match /roleDefinitions/{id} {\n      allow get, list: if isExecutive() || hasPermission('canManagePermissions');\n      allow write: if isExecutive() || hasPermission('canManagePermissions');\n    }\n\n    // LEGACY ROLE PERMISSIONS FALLBACK\n    match /role_permissions/{id} {\n      allow get, list: if isExecutive() || hasPermission('canManagePermissions');\n      allow write: if isExecutive() || hasPermission('canManagePermissions');\n    }\n\n    // USERS COLLECTION - PUBLIC READS WITH STRICT DATA VALIDATION\n    match /users/{userId} {\n      allow get, list: if true;\n      \n      function isValidUserData() {\n        return request.resource.data.points is number &&\n               request.resource.data.upvotes is number &&\n               request.resource.data.downvotes is number;\n      }\n      \n      function isRoleManagementUpdate() {\n        return hasPermission('canManageRoles') && \n               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayRole', 'updatedAt']);\n      }\n\n      allow create: if isSignedIn() && request.auth.uid == userId;\n      allow update: if isOwner(userId) || isSuperAdmin() || isRoleManagementUpdate() || \n                       (hasPermission('canManageUsers') && isValidUserData());\n      allow delete: if isSuperAdmin() || hasPermission('canManageUsers');\n    }\n\n    // ROLES COLLECTION - PUBLIC READ ACCESS\n    match /roles/{userId} {\n      allow get, list: if true;\n      allow create, update, delete: if (isSuperAdmin() || hasPermission('canManageRoles')) && \n                                     userId != 'pLW0PuQCTAQHCNK1SfllVhPZdMz1' &&\n                                     request.resource.data.role != 'superadmin' &&\n                                     request.resource.data.role != 'president_national';\n    }\n\n    // =============================================================\n    // CONTENT COLLECTIONS - Public Read Access\n    // =============================================================\n\n    match /blogs/{blogId} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageBlogs');\n    }\n\n    match /events/{eventId} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageEvents');\n    }\n\n    match /workshops/{workshopId} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageWorkshops');\n    }\n\n    match /announcements/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageAnnouncements');\n    }\n\n    match /projects/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageProjects');\n    }\n\n    match /resources/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageResources');\n    }\n\n    match /legalDocuments/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManagePages');\n    }\n\n    match /timeline/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageTimeline');\n    }\n\n    match /skills/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageSkills');\n    }\n\n    match /forms/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageForms');\n    }\n\n    match /products/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageStore');\n    }\n\n    // =============================================================\n    // ORGANIZATIONAL COLLECTIONS\n    // =============================================================\n\n    match /organizations/{organizationId} {\n      allow get, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageOrganizations');\n    }\n\n    match /chapters/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageChapters');\n    }\n\n    match /positions/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManagePositions');\n    }\n\n    match /badges/{id} {\n      allow read, list: if true;\n      allow write: if isSuperAdmin() || hasPermission('canManageBadges');\n    }\n\n    // =============================================================\n    // OPERATIONAL COLLECTIONS - Mixed Access\n    // =============================================================\n\n    match /tasks/{taskId} {\n      allow read, list: if isSuperAdmin() || hasPermission('canManageTasks') || resource.data.assigneeId == request.auth.uid;\n      allow write: if isSuperAdmin() || hasPermission('canManageTasks');\n    }\n\n    match /role_requests/{id} {\n      allow get: if isSuperAdmin() || hasPermission('canManageRoles') || resource.data.userId == request.auth.uid;\n      allow list: if isSuperAdmin() || hasPermission('canManageRoles');\n      allow create: if isSignedIn();\n      allow update, delete: if isSuperAdmin() || hasPermission('canManageRoles');\n    }\n\n    match /chapter_applications/{id} {\n      allow get: if isSuperAdmin() || hasPermission('canManageChapterApplications') || resource.data.userId == request.auth.uid;\n      allow list: if isSuperAdmin() || hasPermission('canManageChapterApplications');\n      allow create: if isSignedIn();\n      allow update, delete: if isSuperAdmin() || hasPermission('canManageChapterApplications');\n    }\n\n    match /submissions/{id} {\n      allow read, write: if isSuperAdmin() || hasPermission('canManageInbox');\n      allow create: if true; // Allow public form submissions\n    }\n\n    match /eventTickets/{id} {\n      allow read: if isSuperAdmin() || hasPermission('canManageEvents') || resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn();\n    }\n\n    match /orders/{id} {\n      allow read: if isSuperAdmin() || hasPermission('canManageStore') || resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn();\n      allow update: if isSuperAdmin() || hasPermission('canManageStore');\n    }\n\n    match /messages/{id} {\n      allow read: if isSignedIn() && (isSuperAdmin() || hasPermission('canManageTasks') || request.auth.uid in resource.data.participantIds);\n      allow create: if isSignedIn();\n    }\n\n    // =============================================================\n    // SYSTEM COLLECTIONS - Admin Only\n    // =============================================================\n\n    match /settings/{id} {\n      allow read: if true; // Allow public read for Trust Bar stats\n      allow write: if isSuperAdmin() || hasPermission('canManageSiteSettings');\n    }\n\n    match /audit_logs/{id} {\n      allow read: if isSuperAdmin() || hasPermission('canViewAuditLogs');\n      allow create: if isSignedIn();\n    }\n\n    match /bug_reports/{reportId} {\n      allow read, write: if isSuperAdmin() || hasPermission('canManageBugReports');\n      allow create: if isSignedIn();\n    }\n\n    match /pageVisits/{id} {\n      allow read: if isSuperAdmin() || hasPermission('canViewAnalytics');\n      allow create: if true;\n    }\n\n    match /analyticsEvents/{id} {\n      allow read: if isSuperAdmin() || hasPermission('canViewAnalytics');\n      allow create: if true;\n    }\n\n    // Transient collaboration data\n    match /workflow_presence/{id} {\n      allow read, write: if isSignedIn();\n    }\n    match /workflow_typing/{id} {\n      allow read, write: if isSignedIn();\n    }\n\n    // User sub-collections\n    match /users/{userId}/notifications/{id} {\n      allow read: if isOwner(userId);\n      allow write: if isSuperAdmin();\n    }\n\n    match /users/{userId}/warnings/{id} {\n      allow read: if isOwner(userId) || isSuperAdmin() || hasPermission('canManageDefaulters');\n      allow write: if isSuperAdmin() || hasPermission('canManageDefaulters');\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-22T05:22:47.787039Z","metadata":{"services":["cloud.firestore"]}}
