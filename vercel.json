{
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "seds-pakistan",
    "FIREBASE_PROJECT_ID": "seds-pakistan"
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://seds-pakistan.firebaseapp.com/__/auth/$1"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "seds-pakistan.vercel.app"
        }
      ],
      "destination": "https://sedspakistan.live/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "v0-seds-pakistan.vercel.app"
        }
      ],
      "destination": "https://sedspakistan.live/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/overdue",
      "schedule": "5 19 * * *"
    },
    {
      "path": "/api/cron/check-deadlines",
      "schedule": "15 19 * * *"
    },
    {
      "path": "/api/cron/remind-deadlines",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/clear-probation",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-roles",
      "schedule": "40 23 * * *"
    },
    {
      "path": "/api/cron/consent-deadlines",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/governance",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/elections-lifecycle",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/cron/compliance",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/compliance-report",
      "schedule": "0 3 5 1,4,7,10 *"
    }
  ]
}
