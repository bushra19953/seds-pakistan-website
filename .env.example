# ============================================================
# SEDS Pakistan Website - Environment Variables Template
# Copy this file to .env.local and fill in your real values
# ============================================================

# Firebase Client-Side Config (get from Firebase Console → Project Settings → Your App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Drive Picker (get from Google Cloud Console → APIs & Services → Credentials)
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# CAD vault: server-side Google Drive uploads via OAuth as the site owner's Google
# account (free, no Firebase Blaze needed). One-time setup: create a Desktop-app
# OAuth client in GCP, run the consent flow once, and store the refresh token here.
# Create a Drive folder and set GOOGLE_DRIVE_VAULT_FOLDER_ID. Never commit real values.
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token
# Each upload kind gets its own Drive folder. The CAD vault folder ID is required;
# the rest are optional: missing folders are auto-created on first upload.
GOOGLE_DRIVE_VAULT_FOLDER_ID=your_drive_folder_id
# GOOGLE_DRIVE_IMAGES_FOLDER_ID=
# GOOGLE_DRIVE_BUG_REPORTS_FOLDER_ID=
# GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=
# GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=
# GOOGLE_DRIVE_VIDEOS_FOLDER_ID=

# Firebase Admin SDK (get from Firebase Console → Project Settings → Service Accounts)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."} # paste full JSON as one line

# Google OAuth (if using Google Sign-In via server)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com

# Push Notifications (Firebase Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# SMTP Email (optional - project uses Gmail SMTP by default)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=SEDS Pakistan

# Gmail SMTP (used by src/lib/mailer.ts - REQUIRED for email delivery)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Resend (fallback email provider - https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key

# Stripe (https://dashboard.stripe.com/apikeys and → Webhooks)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Firestore inbound webhook shared secret (must match the sender's configuration)
FIRESTORE_WEBHOOK_SECRET=your_firestore_webhook_secret

# Google Gemini (server-side only - https://aistudio.google.com/apikey)
# NEVER expose this to the browser or store it in localStorage.
GEMINI_API_KEY=your_gemini_api_key

# Crucible certificates (server-side only - used by src/lib/certificates/hash.ts)
# Generate with: openssl rand -hex 32
# NEVER expose this to the browser or hardcode it in source files.
CERTIFICATE_SALT=your_random_32_byte_hex_salt

# Node Environment
NODE_ENV=development

# AGP institutional invoicing (server-side only - /api/v1/chapters/invoice)
# Official SEDS Aerospace Private Limited billing details printed on invoices.
SEDS_NTN=0000000-0
SEDS_BANK_NAME=your_bank_name
SEDS_IBAN=PK00_0000_0000_0000_0000_0000
