### P2-T2-MEMORY-LEAKS: System-Wide Real-time Listener Cleanup

#### Action 2.1: Create Standardized React Hook
```typescript
// NEW FILE: src/hooks/use-safe-firestore-subscription.ts
export function useSafeFirestoreSubscription<T>(
  query: Query,
  callback: (data: T[]) => void
) {
  const [data, setData] = useState<T[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);
  
  useEffect(() => {
    const unsubscribe = onSnapshot(query, 
      (snapshot) => {
        const newData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })) as T[];
        setData(newData);
        setLoading(false);
        callback(newData);
      },
      (err) => {
        setError(err);
        setLoading(false);
      }
    );
    
    // CRITICAL: Return cleanup function
    return () => unsubscribe();
  }, [query]);
  
  return { data, loading, error };
}
```

