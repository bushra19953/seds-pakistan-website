### P2-T3-RATE-LIMITING: Implement API Protection

#### Action 3.1: Deploy Rate Limiting Middleware
```typescript
// NEW FILE: src/lib/rate-limiter.ts
import rateLimit from 'express-rate-limit';

export const createRateLimiter = (windowMs: number, max: number) => {
  return rateLimit({
    windowMs,
    max,
    message: 'Too many requests, please try again later.',
    standardHeaders: true,
    legacyHeaders: false,
  });
};

// Apply to API routes
export const apiLimiter = createRateLimit(15 * 60 * 1000, 100); // 100 per 15 minutes
export const aiLimiter = createRateLimit(60 * 60 * 1000, 10); // 10 AI requests per hour
