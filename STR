### P1-T1-SECURITY: Harden Authentication & Authorization Layer

#### Action 1.1: Remove Query Parameter Token Support
**Current Issue**: Multiple token sources create expanded attack surface
**File**: `src/app/api/tasks/route.ts` - Lines 33-44

**Implementation**:
```typescript
// BEFORE (Security Risk)
function extractBearerToken(request: NextRequest): string | undefined {
  const authHeader = request.headers.get('authorization');
  const cookieToken = request.cookies.get('__session')?.value;
  const fromQuery = request.nextUrl.searchParams.get('token'); // REMOVE THIS
  return fromQuery || undefined;
}

// AFTER (Secured)
function extractBearerToken(request: NextRequest): string | undefined {
  const authHeader = request.headers.get('authorization');
  if (authHeader && authHeader.startsWith('Bearer ')) {
    return authHeader.substring('Bearer '.length).trim();
  }
  const cookieToken = request.cookies.get('__session')?.value;
  return cookieToken;
}
```

