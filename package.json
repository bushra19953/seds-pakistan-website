{
  "name": "seds-pakistan-website",
  "version": "1.0.0",
  "description": "Official website for SEDS Pakistan - Students for the Exploration and Development of Space",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:fast": "cross-env NODE_ENV=development next dev -p 9004 --turbo",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "prebuild": "node scripts/check-firebase-init.js",
    "build": "next build",
    "build:analyze": "ANALYZE=true NODE_ENV=production next build",
    "start": "next start -p 9002",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "preview": "npm run build && next start -p 3001",
    "deploy": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=300 firebase deploy --only hosting,functions",
    "clean": "rm -rf .next out node_modules/.cache",
    "postinstall": "patch-package",
    "check:firebase-init": "node scripts/check-firebase-init.js",
    "claims:sync": "node scripts/sync-custom-claims.js",
    "claims:sync:all": "node scripts/sync-custom-claims.js --all",
    "claims:sync:dry": "node scripts/sync-custom-claims.js --dry-run --all",
    "prepare": "husky install"
  },
  "dependencies": {
